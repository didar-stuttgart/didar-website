/**
 * Event Registration Verification Page
 * Path: /registrations/verify?id={registrationId}&token={token}
 * 
 * User-facing verification page that:
 * - Calls the verification API endpoint
 * - Shows loading, success, and error states
 * - Displays capacity status and next steps
 * - Supports Persian and German via i18n
 */

import { useState, useEffect } from 'react';
import { useRouter } from 'next/router';
import Head from 'next/head';
import { t } from '@/lib/i18n';
import styles from '@/styles/verify.module.css';

export default function VerificationPage() {
  const router = useRouter();
  const { id, token } = router.query;
  const [state, setState] = useState('loading'); // loading, success, error
  const [error, setError] = useState('');
  const [capacityStatus, setCapacityStatus] = useState('');
  const currentLang = router.locale || 'de';
  const dir = currentLang === 'fa' ? 'rtl' : 'ltr';

  useEffect(() => {
    if (!id || !token) {
      setState('error');
      setError('Missing verification parameters');
      return;
    }

    // Call the verification API
    async function verify() {
      try {
        const response = await fetch(`/api/registrations/verify?id=${id}&token=${token}`);
        const data = await response.json();

        if (!response.ok) {
          setState('error');
          setError(data.error || 'Verification failed');
          return;
        }

        setCapacityStatus(data.capacityStatus || '');
        setState('success');
      } catch (err) {
        setState('error');
        setError('An error occurred during verification');
        console.error('Verification error:', err);
      }
    }

    verify();
  }, [id, token]);

  const pageTitle = currentLang === 'fa' ? 'تأیید ثبت‌نام - دیدار' : 'Anmeldungsbestätigung - DIDAR';

  return (
    <>
      <Head>
        <title>{pageTitle}</title>
      </Head>

      <div className={styles.container} dir={dir}>
        <div className={styles.card}>
          {state === 'loading' && (
            <div className={styles.loading}>
              <div className={styles.spinner}></div>
              <h1>{t('registration.verification_loading', currentLang)}</h1>
              <p>{t('registration.verification_loading_message', currentLang)}</p>
            </div>
          )}

          {state === 'success' && (
            <div className={styles.success}>
              <div className={styles.icon}>✓</div>
              <h1>{t('registration.success', currentLang)}</h1>
              <p>{t('registration.verify_message', currentLang)}</p>

              {capacityStatus === 'at_capacity' && (
                <div className={styles.info}>
                  <p>{t('registration.capacity_full', currentLang)}</p>
                </div>
              )}

              <button
                className={styles.button}
                onClick={() => router.push(`/${currentLang}/veranstaltungen`)}
              >
                {t('registration.back_to_events', currentLang)}
              </button>
            </div>
          )}

          {state === 'error' && (
            <div className={styles.error}>
              <div className={styles.icon}>✗</div>
              <h1>{t('registration.verification_error', currentLang)}</h1>
              <p className={styles.errorMessage}>{error}</p>

              <div className={styles.errorDetails}>
                {error.includes('already') && (
                  <p>{t('registration.error_already_verified', currentLang)}</p>
                )}
                {error.includes('invalid') && (
                  <p>{t('registration.error_invalid_token', currentLang)}</p>
                )}
                {error.includes('not found') && (
                  <p>{t('registration.error_not_found', currentLang)}</p>
                )}
              </div>

              <button
                className={styles.button}
                onClick={() => router.push(`/${currentLang}/veranstaltungen`)}
              >
                {t('registration.back_to_events', currentLang)}
              </button>
            </div>
          )}
        </div>
      </div>
    </>
  );
}
