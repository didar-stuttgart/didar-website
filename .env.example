# Supabase Configuration
# Get these values from your Supabase project: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Supabase Secret Key (Admin operations only, Phase 3+)
# IMPORTANT: Keep this SECRET - never expose to client
# Get from Supabase: Settings > API > Secret Keys
# Only needed when building admin dashboard (Phase 3)
SUPABASE_SECRET_KEY=your-secret-key-here

# Admin Authentication
# Set a strong password for the admin account (used during initial setup)
# Change this to a secure random string
ADMIN_PASSWORD_HASH=will-be-generated-during-setup

# Deployment
# Used by Vercel to know which environment this is
NODE_ENV=development
VERCEL_ENV=development

# API Rate Limiting
# Number of requests per minute for form submissions
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000
